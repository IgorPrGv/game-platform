# Copie para .env. Só valores do ambiente local; nunca coloque segredos reais aqui.
NODE_ENV=development

# MongoDB (contêiner mongo)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=localdev
MONGO_URL=mongodb://root:localdev@localhost:27017/game_platform?authSource=admin

# Credenciais aceitas pelos emuladores da AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# S3 (SeaweedFS); exige endereçamento por caminho (forcePathStyle)
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_BUCKET=app-data

# DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=offers

# SQS (ElasticMQ)
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE=moderation-results
SQS_QUEUE_URL=http://localhost:9324/000000000000/moderation-results

# Portas no computador (mude se alguma já estiver em uso)
MONGO_PORT=27017
S3_PORT=8333
DYNAMODB_PORT=8000
SQS_PORT=9324
